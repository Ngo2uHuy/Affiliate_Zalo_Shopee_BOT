# Copy thành .env rồi điền. KHÔNG chia sẻ/đưa .env lên GitHub.
ZALO_BOT_TOKEN=DAN_BOT_TOKEN_ZALO
# Chuỗi ngẫu nhiên 8-256 ký tự, Zalo gửi kèm mỗi request để bot biết đúng là Zalo.
ZALO_WEBHOOK_SECRET=DOI_THANH_CHUOI_NGAU_NHIEN_DAI
# demo: chỉ nhắc lại link; live: tạo link affiliate thật (cần App ID/Secret từ Shopee Affiliate Open API).
SHOPEE_MODE=demo
SHOPEE_APP_ID=
SHOPEE_SECRET=
# Luồng AffiPad: đổi SHOPEE_MODE=affipad rồi điền hai giá trị dưới đây.
# Không cần Shopee App ID/Secret trong mode affipad.
AFFIPAD_API_KEY=
AFFIPAD_TOOL_ID=
# Tuỳ chọn: trang Facebook của bạn, gửi kèm khi sản phẩm chưa có bài đăng trong facebook_posts.json.
FACEBOOK_PAGE_URL=
# Tuỳ chọn: bài Facebook "săn mã". Bot Zalo gửi kèm link bài để khách mở sản phẩm từ Facebook
# (mã độc quyền Facebook/Instagram chỉ áp khi bấm từ Facebook). Nội dung mã ghi trong deal_vouchers.txt.
FACEBOOK_DEAL_POST_URL=
# Tuỳ chọn: bot tự comment link lên bài. Bài phải thuộc Fanpage; ID dạng pageid_postid;
# Page access token cần quyền pages_manage_engagement. Bỏ trống thì bạn tự comment.
FACEBOOK_DEAL_POST_ID=
FACEBOOK_PAGE_TOKEN=
PORT=8080
WORKERS=4
